  "font": {
    "family": {
      "display": "'Space Grotesk', 'Manrope', system-ui, sans-serif",
      "body": "'Manrope', system-ui, -apple-system, 'Segoe UI', sans-serif",
      "mono": "'JetBrains Mono', ui-monospace, 'SF Mono', Menlo, monospace"
    },
    "size": {
      "2xs": "11px",
      "xs": "12px",
      "sm": "13px",
      "md": "14px",
      "lg": "16px",
      "xl": "18px",
      "2xl": "22px",
      "3xl": "28px",
      "4xl": "36px",
      "5xl": "48px",
      "6xl": "64px"
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "leading": {
      "tight": 1.1,
      "snug": 1.3,
      "normal": 1.5,
      "relaxed": 1.65
    },
    "tracking": {
      "display": "-0.02em",
      "normal": "0",
      "label": "0.14em"
    }
  },
  "type": {
    "$description": "Styles composés. Échelle « produit » (interfaces) ; l'échelle « éditoriale » (site, slides) monte à 64 px.",
    "display": {
      "family": "display",
      "size": "5xl",
      "weight": 700,
      "leading": 1.05,
      "tracking": "-0.02em"
    },
    "h1": {
      "family": "display",
      "size": "3xl",
      "weight": 700,
      "leading": 1.15,
      "tracking": "-0.015em"
    },
    "h2": {
      "family": "display",
      "size": "2xl",
      "weight": 700,
      "leading": 1.2,
      "tracking": "-0.01em"
    },
    "h3": {
      "family": "display",
      "size": "xl",
      "weight": 600,
      "leading": 1.3,
      "tracking": "0"
    },
    "body-lg": {
      "family": "body",
      "size": "lg",
      "weight": 400,
      "leading": 1.6
    },
    "body": {
      "family": "body",
      "size": "md",
      "weight": 400,
      "leading": 1.55
    },
    "caption": {
      "family": "body",
      "size": "xs",
      "weight": 500,
      "leading": 1.4
    },
    "label": {
      "family": "mono",
      "size": "2xs",
      "weight": 500,
      "leading": 1.2,
      "tracking": "0.14em",
      "transform": "uppercase",
      "$description": "Surtitre éditorial (site, slides, documents). Pas pour les libellés d'interface produit."
    },
    "ui-label": {
      "family": "body",
      "size": "xs",
      "weight": 500,
      "leading": 1.35,
      "tracking": "0",
      "transform": "none",
      "$description": "Libellé d'interface produit (champs, tuiles, colonnes) : Manrope, sans capitales."
    },
    "kpi": {
      "family": "display",
      "size": "3xl",
      "weight": 600,
      "leading": 1.1,
      "tracking": "-0.02em",
      "$description": "Chiffre clé d'une tuile ou d'une bande de KPI."
    },
    "data": {
      "family": "mono",
      "size": "md",
      "weight": 500,
      "leading": 1.3
    },
    "code": {
      "family": "mono",
      "size": "sm",
      "weight": 400,
      "leading": 1.6
    }
  },
  "space": {
    "0": "0",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "24px",
    "6": "32px",
    "7": "48px",
    "8": "64px",
    "9": "96px"
  },
  "radius": {
    "none": "0",
    "sm": "3px",
    "md": "6px",
    "lg": "10px",
    "pill": "999px",
    "$description": "Rayons du symbole (7/146 du bloc) : des blocs à peine adoucis, jamais de pilule pour un bouton. pill est réservé aux pastilles de données."
  },
  "shadow": {
    "none": "none",
    "card": "0 1px 2px rgba(22, 19, 15, 0.06)",
    "raised": "0 8px 24px rgba(22, 19, 15, 0.08)",
    "overlay": "0 24px 64px rgba(22, 19, 15, 0.22)"
  },
  "motion": {
    "duration": {
      "fast": "120ms",
      "base": "200ms",
      "slow": "320ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "enter": "cubic-bezier(0, 0, 0, 1)",
      "exit": "cubic-bezier(0.3, 0, 1, 1)"
    }
  },
  "layout": {
    "grid-columns": 12,
    "gutter": "24px",
    "container": "1200px",
    "breakpoint": {
      "sm": "640px",
      "md": "768px",
      "lg": "1024px",
      "xl": "1280px"
    }
  },
  "icon": {
    "stroke": 1.5,
    "grid": 24,
    "library": "lucide",
    "sizes": {
      "sm": "16px",
      "md": "20px",
      "lg": "24px"
    }
  },
  "z": {
    "dropdown": 1000,
    "sticky": 1100,
    "drawer": 1200,
    "modal": 1300,
    "toast": 1400,
    "tooltip": 1500
  }
}
