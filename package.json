{
  "name": "@kmt/design-system",
  "version": "1.2.0",
  "description": "Design system KMT — tokens, composants UI, logos, documents officiels. Source unique : tokens/tokens.json.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "ui",
    "fonts",
    "logo",
    "tokens",
    "marque/src",
    "marque/LICENCE"
  ],
  "exports": {
    ".": "./dist/js/kmt-tokens.mjs",
    "./tokens.json": "./dist/js/kmt-tokens.json",
    "./css": "./dist/css/kmt-tokens.css",
    "./ui.css": "./ui/kmt-ui.css",
    "./fonts.css": "./fonts/kmt-fonts.css",
    "./fonts/*": "./fonts/*",
    "./tailwind": "./dist/tailwind/kmt-preset.cjs",
    "./tailwind.css": "./dist/tailwind/kmt-theme.css",
    "./cli": "./dist/terminal/kmt-cli.mjs",
    "./edms-theme.json": "./dist/edms/theme.json",
    "./marque": {
      "types": "./marque/src/index.d.ts",
      "default": "./marque/src/index.js"
    },
    "./logo/*": "./logo/*"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:docs": "python3 scripts/build_docs.py",
    "test:marque": "node --test marque/test/"
  }
}
