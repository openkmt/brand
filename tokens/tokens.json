{
  "$description": "KMT — tokens de design. Source unique de vérité : tout le reste (CSS, Tailwind, Zeno, EDMS, terminal, documents) est généré depuis ce fichier par scripts/build.mjs. Format proche W3C Design Tokens (DTCG).",
  "$version": "1.0.0",

  "color": {
    "brand": {
      "noir-kmt": { "$type": "color", "$value": "#16130F", "$description": "Fond signature, texte principal. 22 % des usages." },
      "papyrus":    { "$type": "color", "$value": "#F4EEE3", "$description": "Fond par défaut. 55 % des usages." },
      "or-solaire": { "$type": "color", "$value": "#C9993B", "$description": "Le symbole, l'action secondaire, les chiffres. 8 %. Jamais en texte sur fond clair." },
      "nil":        { "$type": "color", "$value": "#2E5A5C", "$description": "Liens, information, accent froid. 5 %." },
      "sable":      { "$type": "color", "$value": "#D8CFBD", "$description": "Filets, surfaces calmes. 10 %." }
    },

    "neutre": {
      "0":   { "$type": "color", "$value": "#FFFFFF" },
      "25":  { "$type": "color", "$value": "#FBF8F2" },
      "50":  { "$type": "color", "$value": "#F4EEE3" },
      "100": { "$type": "color", "$value": "#ECE5D7" },
      "200": { "$type": "color", "$value": "#D8CFBD" },
      "300": { "$type": "color", "$value": "#BDB3A0" },
      "400": { "$type": "color", "$value": "#9A9081" },
      "500": { "$type": "color", "$value": "#7A7266" },
      "600": { "$type": "color", "$value": "#5E574D" },
      "700": { "$type": "color", "$value": "#433D35" },
      "800": { "$type": "color", "$value": "#2A2520" },
      "850": { "$type": "color", "$value": "#1F1B16" },
      "900": { "$type": "color", "$value": "#1A1612" },
      "950": { "$type": "color", "$value": "#16130F" }
    },
    "or": {
      "50":  { "$type": "color", "$value": "#FBF4E4" },
      "100": { "$type": "color", "$value": "#F4E4BF" },
      "200": { "$type": "color", "$value": "#EBCF8E" },
      "300": { "$type": "color", "$value": "#DDB561" },
      "400": { "$type": "color", "$value": "#D2A648" },
      "500": { "$type": "color", "$value": "#C9993B" },
      "600": { "$type": "color", "$value": "#A87D2B" },
      "700": { "$type": "color", "$value": "#866222" },
      "800": { "$type": "color", "$value": "#644A1C" },
      "900": { "$type": "color", "$value": "#453314" }
    },
    "nil": {
      "50":  { "$type": "color", "$value": "#E8F0EF" },
      "100": { "$type": "color", "$value": "#CCDEDD" },
      "200": { "$type": "color", "$value": "#9CBFBE" },
      "300": { "$type": "color", "$value": "#6B9C9C" },
      "400": { "$type": "color", "$value": "#467A7B" },
      "500": { "$type": "color", "$value": "#2E5A5C" },
      "600": { "$type": "color", "$value": "#254A4C" },
      "700": { "$type": "color", "$value": "#1D3A3B" },
      "800": { "$type": "color", "$value": "#152A2B" },
      "900": { "$type": "color", "$value": "#0E1C1D" }
    },
    "palmier": {
      "$description": "Vert de succès, accordé à la palette (pas un vert néon).",
      "50":  { "$type": "color", "$value": "#E7F2E9" },
      "300": { "$type": "color", "$value": "#7DBE8A" },
      "500": { "$type": "color", "$value": "#3D7A4A" },
      "700": { "$type": "color", "$value": "#2A5534" }
    },
    "terre": {
      "$description": "Terre cuite, couleur d'erreur et de danger.",
      "50":  { "$type": "color", "$value": "#F7E6E1" },
      "300": { "$type": "color", "$value": "#E8826B" },
      "500": { "$type": "color", "$value": "#B2452F" },
      "700": { "$type": "color", "$value": "#7E2F20" }
    }
  },

  "theme": {
    "$description": "Rôles sémantiques. Les composants n'utilisent QUE ces rôles, jamais les primitives. Principe : pas de traits. La structure vient de l'espace, des fonds (bg-*) et de la typographie ; les border-* ne servent qu'en dernier recours (séparation imprimée indispensable, contraste forcé).",
    "clair": {
      "bg-page":        "{color.neutre.50}",
      "bg-card":        "{color.neutre.0}",
      "bg-subtle":      "{color.neutre.25}",
      "bg-muted":       "{color.neutre.100}",
      "bg-inverse":     "{color.neutre.950}",
      "bg-field":       "rgba(22, 19, 15, 0.045)",
      "bg-field-hover": "rgba(22, 19, 15, 0.07)",
      "bg-hover":       "rgba(22, 19, 15, 0.035)",
      "text-primary":   "{color.neutre.950}",
      "text-secondary": "{color.neutre.700}",
      "text-muted":     "{color.neutre.600}",
      "text-inverse":   "{color.neutre.50}",
      "text-link":      "{color.nil.500}",
      "text-gold":      "{color.or.700}",
      "border-subtle":  "rgba(22, 19, 15, 0.08)",
      "border-default": "{color.neutre.200}",
      "border-strong":  "{color.neutre.400}",
      "action-primary":       "{color.neutre.950}",
      "action-primary-hover": "{color.neutre.800}",
      "on-action-primary":    "{color.neutre.50}",
      "action-brand":         "{color.or.500}",
      "action-brand-hover":   "{color.or.400}",
      "on-action-brand":      "{color.neutre.950}",
      "accent":         "{color.or.500}",
      "accent-soft":    "{color.or.50}",
      "focus-ring":     "{color.or.500}",
      "scrim":          "rgba(22, 19, 15, 0.45)",
      "success":        "{color.palmier.500}",
      "success-soft":   "{color.palmier.50}",
      "warning":        "{color.or.700}",
      "warning-soft":   "{color.or.50}",
      "danger":         "{color.terre.500}",
      "danger-soft":    "{color.terre.50}",
      "info":           "{color.nil.500}",
      "info-soft":      "{color.nil.50}",
      "neutral":        "{color.neutre.700}",
      "neutral-soft":   "{color.neutre.100}"
    },
    "sombre": {
      "bg-page":        "{color.neutre.950}",
      "bg-card":        "{color.neutre.850}",
      "bg-subtle":      "{color.neutre.900}",
      "bg-muted":       "{color.neutre.800}",
      "bg-inverse":     "{color.neutre.50}",
      "bg-field":       "rgba(244, 238, 227, 0.06)",
      "bg-field-hover": "rgba(244, 238, 227, 0.09)",
      "bg-hover":       "rgba(244, 238, 227, 0.04)",
      "text-primary":   "{color.neutre.50}",
      "text-secondary": "{color.neutre.300}",
      "text-muted":     "{color.neutre.400}",
      "text-inverse":   "{color.neutre.950}",
      "text-link":      "{color.nil.200}",
      "text-gold":      "{color.or.500}",
      "border-subtle":  "rgba(244, 238, 227, 0.08)",
      "border-default": "rgba(244, 238, 227, 0.14)",
      "border-strong":  "rgba(244, 238, 227, 0.32)",
      "action-primary":       "{color.or.500}",
      "action-primary-hover": "{color.or.400}",
      "on-action-primary":    "{color.neutre.950}",
      "action-brand":         "{color.or.500}",
      "action-brand-hover":   "{color.or.400}",
      "on-action-brand":      "{color.neutre.950}",
      "accent":         "{color.or.500}",
      "accent-soft":    "rgba(201, 153, 59, 0.14)",
      "focus-ring":     "{color.or.400}",
      "scrim":          "rgba(0, 0, 0, 0.6)",
      "success":        "{color.palmier.300}",
      "success-soft":   "rgba(125, 190, 138, 0.14)",
      "warning":        "{color.or.300}",
      "warning-soft":   "rgba(221, 181, 97, 0.14)",
      "danger":         "{color.terre.300}",
      "danger-soft":    "rgba(232, 130, 107, 0.14)",
      "info":           "{color.nil.200}",
      "info-soft":      "rgba(156, 191, 190, 0.14)",
      "neutral":        "{color.neutre.300}",
      "neutral-soft":   "rgba(244, 238, 227, 0.08)"
    }
  },

  "font": {
    "family": {
      "display": { "$type": "fontFamily", "$value": "'Space Grotesk', 'Manrope', system-ui, sans-serif", "$description": "Titres et wordmark." },
      "body":    { "$type": "fontFamily", "$value": "'Manrope', system-ui, -apple-system, 'Segoe UI', sans-serif", "$description": "Texte courant et interface." },
      "mono":    { "$type": "fontFamily", "$value": "'JetBrains Mono', ui-monospace, 'SF Mono', Menlo, monospace", "$description": "Labels, code, données, CLI." }
    },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "size": {
      "2xs": "11px", "xs": "12px", "sm": "13px", "md": "14px", "lg": "16px", "xl": "18px",
      "2xl": "22px", "3xl": "28px", "4xl": "36px", "5xl": "48px", "6xl": "64px"
    },
    "leading": { "tight": 1.1, "snug": 1.3, "normal": 1.5, "relaxed": 1.65 },
    "tracking": { "display": "-0.02em", "normal": "0", "label": "0.14em" }
  },

  "type": {
    "$description": "Styles composés. Échelle « produit » (interfaces) ; l'échelle « éditoriale » (site, slides) monte à 64 px.",
    "display":  { "family": "display", "size": "5xl", "weight": 700, "leading": 1.05, "tracking": "-0.02em" },
    "h1":       { "family": "display", "size": "3xl", "weight": 700, "leading": 1.15, "tracking": "-0.015em" },
    "h2":       { "family": "display", "size": "2xl", "weight": 700, "leading": 1.2,  "tracking": "-0.01em" },
    "h3":       { "family": "display", "size": "xl",  "weight": 600, "leading": 1.3,  "tracking": "0" },
    "body-lg":  { "family": "body", "size": "lg", "weight": 400, "leading": 1.6 },
    "body":     { "family": "body", "size": "md", "weight": 400, "leading": 1.55 },
    "caption":  { "family": "body", "size": "xs", "weight": 500, "leading": 1.4 },
    "label":    { "family": "mono", "size": "2xs", "weight": 500, "leading": 1.2, "tracking": "0.14em", "transform": "uppercase", "$description": "Surtitre éditorial (site, slides, documents). Pas pour les libellés d'interface produit." },
    "ui-label": { "family": "body", "size": "xs", "weight": 500, "leading": 1.35, "tracking": "0", "transform": "none", "$description": "Libellé d'interface produit (champs, tuiles, colonnes) : Manrope, sans capitales." },
    "kpi":      { "family": "display", "size": "3xl", "weight": 600, "leading": 1.1, "tracking": "-0.02em", "$description": "Chiffre clé d'une tuile ou d'une bande de KPI." },
    "data":     { "family": "mono", "size": "md", "weight": 500, "leading": 1.3 },
    "code":     { "family": "mono", "size": "sm", "weight": 400, "leading": 1.6 }
  },

  "space": { "0": "0", "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "24px", "6": "32px", "7": "48px", "8": "64px", "9": "96px" },
  "radius": { "none": "0", "sm": "3px", "md": "6px", "lg": "10px", "pill": "999px", "$description": "Rayons du symbole (7/146 du bloc) : des blocs à peine adoucis, jamais de pilule pour un bouton. pill est réservé aux pastilles de données." },
  "joint": { "$value": "3px", "$description": "L'écart entre deux modules, comme entre les blocs du symbole. Signature de toute l'interface : bouton + module, onglets, lignes de tableau, jauges." },
  "shadow": {
    "none":    "none",
    "card":    "0 1px 2px rgba(22, 19, 15, 0.06)",
    "raised":  "0 8px 24px rgba(22, 19, 15, 0.08)",
    "overlay": "0 24px 64px rgba(22, 19, 15, 0.22)"
  },
  "motion": {
    "duration": { "fast": "120ms", "base": "200ms", "slow": "320ms" },
    "easing": { "standard": "cubic-bezier(0.2, 0, 0, 1)", "enter": "cubic-bezier(0, 0, 0, 1)", "exit": "cubic-bezier(0.3, 0, 1, 1)" }
  },
  "layout": {
    "grid-columns": 12,
    "gutter": "24px",
    "container": "1200px",
    "breakpoint": { "sm": "640px", "md": "768px", "lg": "1024px", "xl": "1280px" }
  },
  "icon": { "stroke": 1.5, "grid": 24, "library": "lucide", "sizes": { "sm": "16px", "md": "20px", "lg": "24px" } },
  "z": { "dropdown": 1000, "sticky": 1100, "drawer": 1200, "modal": 1300, "toast": 1400, "tooltip": 1500 }
}
